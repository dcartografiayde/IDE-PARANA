        },
        onEachFeature: (f, l) => {
            let p = f.properties || {};

            l.on('click', e => {
                let latlng = e.latlng || l.getBounds().getCenter();
                let colorRiesgo = obtenerColorPoligonoRiesgo(p);
                let sv = `https://www.google.com/maps/@?api=1&map_action=pano&viewpoint=${latlng.lat},${latlng.lng}`;

                let content = `<div class="popup-custom">
                    <div class="popup-header" style="color:${colorRiesgo};">⚠️ POLÍGONO DE RIESGO SOCIOAMBIENTAL</div>
                    <table class="table-info">`;
                
                for (let [k, v] of Object.entries(p)) {
                    if (v !== undefined && v !== null && v !== "0" && String(v).trim() !== "null") {
                        content += `<tr><td>${decodificarTexto(k).toUpperCase()}</td><td>${decodificarTexto(String(v))}</td></tr>`;
                    }
                }
                
                content += `</table>
                    <a href="${sv}" target="_blank" class="btn-streetview">📍 STREET VIEW</a>
                    <div class="adv-sv">Consulte el resumen ejecutivo en el menú lateral.</div>
                </div>`;

                l.bindPopup(content, { autoPanPadding: L.point(10, 110) }).openPopup(latlng);
            });
        }
    }).addTo(grupoRiesgoPoligonos);

    controlarVisibilidadDinamica();
}).catch(err => {
    console.error("Error al cargar capas de riesgo ambiental:", err);
});

// Gestión unificada de visibilidad dinámica
function controlarVisibilidadDinamica() {
    let zoomActual = map.getZoom();
    
    document.getElementById('zoom-indicator').innerText = zoomActual;

    // Control de visibilidad de etiquetas de puntos (Visibles a partir de zoom >= 16)
    const mapContainer = map.getContainer();
    if (zoomActual >= 16) {
        mapContainer.classList.remove('ocultar-etiquetas');
    } else {
        mapContainer.classList.add('ocultar-etiquetas');
    }

    // 1. Visibilidad de Manzanas
    const chkManzanas = document.getElementById('chk-manzanas').checked;
    if (chkManzanas) {
        if (!map.hasLayer(grupoManzanas)) map.addLayer(grupoManzanas);
    } else {
        if (map.hasLayer(grupoManzanas)) map.removeLayer(grupoManzanas);
    }

    // 2. Visibilidad de Calles (Zoom >= 15)
    const chkCalles = document.getElementById('chk-calles').checked;
    if (chkCalles && zoomActual >= 15) {
        if (!map.hasLayer(grupoCalles)) map.addLayer(grupoCalles);
    } else {
        if (map.hasLayer(grupoCalles)) map.removeLayer(grupoCalles);
    }

    // 3. Visibilidad de Parcelas Catastrales (Zoom >= 16)
    const chkParcelas = document.getElementById('chk-parcelas').checked;
    if (chkParcelas && zoomActual >= 16) {
        if (!map.hasLayer(grupoParcelas)) map.addLayer(grupoParcelas);
    } else {
        if (map.hasLayer(grupoParcelas)) map.removeLayer(grupoParcelas);
    }

    // 4. Visibilidad de Polígonos de Riesgo Ambiental
    const chkRiesgoPoligonos = document.getElementById('chk-riesgo-poligonos').checked;
    if (chkRiesgoPoligonos) {
        if (!map.hasLayer(grupoRiesgoPoligonos)) map.addLayer(grupoRiesgoPoligonos);
    } else {
        if (map.hasLayer(grupoRiesgoPoligonos)) map.removeLayer(grupoRiesgoPoligonos);
    }

    // 5. Visibilidad de Puntos de Riesgo Ambiental
    const chkRiesgoPuntos = document.getElementById('chk-riesgo-puntos').checked;
    if (chkRiesgoPuntos) {
        if (!map.hasLayer(grupoRiesgoPuntos)) map.addLayer(grupoRiesgoPuntos);
    } else {
        if (map.hasLayer(grupoRiesgoPuntos)) map.removeLayer(grupoRiesgoPuntos);
    }
}

map.on('zoomend', controlarVisibilidadDinamica);
map.on('layeradd layerremove', controlarVisibilidadDinamica); 

/* ================= CONTROLES Y BÚSQUEDA DEL MENÚ LATERAL ================= */

function toggleSidebar() {
    const sidebar = document.getElementById('sidebar');
    const toggleIcon = document.getElementById('toggle-icon');

    if (sidebar.classList.contains('-translate-x-full')) {
        sidebar.classList.remove('-translate-x-full');
        toggleIcon.classList.remove('rotate-180');
    } else {
        sidebar.classList.add('-translate-x-full');
        toggleIcon.classList.add('rotate-180');
    }
}

function cambiarBaseMap(tipo) {
    map.removeLayer(dark);
    map.removeLayer(hibrido);
    map.removeLayer(osm);
    
    if (tipo === 'dark') dark.addTo(map);
    if (tipo === 'hibrido') hibrido.addTo(map);
    if (tipo === 'osm') osm.addTo(map);
}

function toggleOverlay(capa) {
    controlarVisibilidadDinamica();
}

function buscarPM() {
    let val = document.getElementById('input-pm').value.trim();
    if (!val) return;
    let encontrado = false;
    parcelasLayers.forEach(ly => {
        ly.eachLayer(l => {
            if (l.feature.properties.partidas.includes(val)) {
                map.fitBounds(l.getBounds(), { maxZoom: 19 });
                
                document.getElementById('chk-parcelas').checked = true;
                controlarVisibilidadDinamica();

                l.fire('click');
                encontrado = true;
            }
        });
    });
}

function buscarPredictivoUbicacion(query) {
    if (!query || query.length < 3) return [];
    let cleanQuery = query.toUpperCase().trim();
    let matches = [];

    for (let i = 0; i < listaParcelasUbicacion.length; i++) {
        let item = listaParcelasUbicacion[i];
        if (item.texto.startsWith(cleanQuery)) {
            matches.push(item);
            if (matches.length >= 10) break;
        }
    }

    if (matches.length < 10) {
        for (let i = 0; i < listaParcelasUbicacion.length; i++) {
            let item = listaParcelasUbicacion[i];
            if (!item.texto.startsWith(cleanQuery) && item.texto.includes(cleanQuery)) {
                matches.push(item);
                if (matches.length >= 12) break;
            }
        }
    }
    return matches;
}

function configurarBuscadorUbicaciones() {
    const input = document.getElementById('input-ubicacion');
    const sug = document.getElementById('sugerencias-ubicacion');

    input.addEventListener('input', () => {
        let val = input.value;
        sug.innerHTML = '';
        if (val.length < 3) {
            sug.style.display = 'none';
            return;
        }

        let matches = buscarPredictivoUbicacion(val);

        if (matches.length > 0) {
            sug.style.display = 'block';
            let textosAgregados = new Set();

            matches.forEach(m => {
                if (!textosAgregados.has(m.texto)) {
                    textosAgregados.add(m.texto);
                    let d = document.createElement('div');
                    d.className = 'px-3 py-1.5 cursor-pointer text-xs text-slate-300 hover:bg-blue-600 hover:text-white border-b border-slate-800 last:border-none transition duration-150';
                    d.innerText = m.texto;
                    d.onclick = () => {
                        input.value = m.texto;
                        sug.style.display = 'none';
                        
                        if (m.layer) {
                            map.fitBounds(m.layer.getBounds(), { maxZoom: 19 });
                            document.getElementById('chk-parcelas').checked = true;
                            controlarVisibilidadDinamica();
                            m.layer.fire('click');
                        }
                    };
                    sug.appendChild(d);
                }
            });
        } else {
            sug.style.display = 'none';
        }
    });

    document.addEventListener('click', (e) => {
        if (e.target !== input && e.target !== sug) {
            sug.style.display = 'none';
        }
    });
}

function buscarGoogle() {
    let val = document.getElementById('input-google').value.trim();
    if (!val) return;
    fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(val + ", Paraná, Entre Ríos")}`)
        .then(r => r.json()).then(data => {
            if (data && data.length > 0) {
                const lat = parseFloat(data[0].lat);
                const lon = parseFloat(data[0].lon);
                map.setView([lat, lon], 18);
                L.marker([lat, lon]).addTo(map).bindPopup(`<b>Resultado Google:</b><br>${val}`).openPopup();
            }
        });
}

