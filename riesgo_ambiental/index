/* ================= LÓGICA Y CLASIFICACIÓN PRECISA DE PUNTOS Y POLÍGONOS DE RIESGO =================
   🔴 Alto: Rojo (#ef4444)
   🟠 Medio: Naranja (#f97316)
   🟡 Bajo: Amarillo (#facc15)
   🔵 Residual: Azul (#3b82f6)
*/
function obtenerColorPuntoRiesgo(props) {
    if (!props) return '#ef4444';
    
    let valCriterio = '';

    // Búsqueda prioritaria de la propiedad "CRITERIOS DE CLASIFICACIÓN" o variantes específicas
    for (let k in props) {
        if (!props[k]) continue;
        let kClean = k.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim();
        if (kClean.includes('criterio') || kClean === 'clasificacion' || kClean.includes('clasificaci')) {
            let strVal = decodificarTexto(String(props[k])).toLowerCase().trim();
            if (strVal.includes('alto') || strVal.includes('alta') || strVal.includes('medio') || strVal.includes('media') || strVal.includes('bajo') || strVal.includes('baja') || strVal.includes('residual')) {
                valCriterio = strVal;
                break;
            }
        }
    }

    // Si no encontró en un campo directo con la palabra 'criterio', buscar en los valores directos
    if (!valCriterio) {
        for (let k in props) {
            if (!props[k]) continue;
            let strVal = decodificarTexto(String(props[k])).toLowerCase().trim();
            if (strVal === 'alto' || strVal === 'alta' || strVal === 'medio' || strVal === 'media' || strVal === 'bajo' || strVal === 'baja' || strVal === 'residual') {
                valCriterio = strVal;
                break;
            }
        }
    }

    // Evaluación directa del criterio de clasificación
    if (valCriterio.includes('alto') || valCriterio.includes('alta')) return '#ef4444';    // Rojo
    if (valCriterio.includes('medio') || valCriterio.includes('media')) return '#f97316';  // Naranja
    if (valCriterio.includes('bajo') || valCriterio.includes('baja')) return '#facc15';   // Amarillo
    if (valCriterio.includes('residual')) return '#3b82f6';                               // Azul
    
    return '#ef4444'; // Fallback por defecto (Alto)
}

function obtenerColorPoligonoRiesgo(props) {
    if (!props) return '#f43f5e';

    let valName = props.name || props.NAME || props.id || props.ID;
    let idNorm = normalizarId(valName);

    // Si coincide con un Punto de Afectación identificado, toma su color exacto de clasificación
    if (idNorm && mapaColoresPuntosPorId[idNorm]) {
        return mapaColoresPuntosPorId[idNorm];
    }

    // O bien, evalúa si sus propiedades contienen el nivel de riesgo directamente
    for (let k in props) {
        if (!props[k]) continue;
        let strVal = decodificarTexto(String(props[k])).toLowerCase().trim();
        if (strVal.includes('alto') || strVal.includes('alta')) return '#ef4444';
        if (strVal.includes('medio') || strVal.includes('media')) return '#f97316';
        if (strVal.includes('bajo') || strVal.includes('baja')) return '#facc15';
        if (strVal.includes('residual')) return '#3b82f6';
    }

    return '#f43f5e'; // Fallback
}

