                            }
                        } catch (err) {}
                    }
                }
            });
        });
    };

    map.on('zoomend moveend', renderLabels);
    map.on('layeradd layerremove', (e) => {
        if (e.layer === grupoCalles) {
            renderLabels();
        }
    });

    renderLabels();
}

