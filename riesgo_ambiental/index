function activarEtiquetasCalles() {
    const renderLabels = () => {
        let z = map.getZoom();
        const activeOnMap = map.hasLayer(grupoCalles);

        let etiquetasColocadas = {}; 

        grupoCalles.eachLayer(geoJsonGroup => {
            geoJsonGroup.eachLayer(ly => {
                if (ly.setText) {
                    try { ly.setText(null); } catch (e) {}

                    if (activeOnMap && z >= 16 && ly._map && ly._renderer && ly.feature && ly.feature.properties.nombre) {
                        try {
                            if (map.getBounds().intersects(ly.getBounds())) {
                                let nombreCalle = decodificarTexto(ly.feature.properties.nombre).toUpperCase();

                                let latlngs = ly.getLatLngs();
                                if (Array.isArray(latlngs[0])) latlngs = latlngs.flat(2);
                                
                                let largoMetros = 0;
                                for (let i = 0; i < latlngs.length - 1; i++) {
                                    if (latlngs[i] && latlngs[i+1]) {
                                        largoMetros += latlngs[i].distanceTo(latlngs[i+1]);
                                    }
                                }

                                if (largoMetros < 70) return;

                                let centro = ly.getBounds().getCenter();

                                let duplicadoCercano = false;
                                if (etiquetasColocadas[nombreCalle]) {
                                    for (let pt of etiquetasColocadas[nombreCalle]) {
                                        if (centro.distanceTo(pt) < 200) {
                                            duplicadoCercano = true;
                                            break;
                                        }
                                    }
                                }

                                if (!duplicadoCercano) {
                                    if (!etiquetasColocadas[nombreCalle]) {
                                        etiquetasColocadas[nombreCalle] = [];
                                    }
                                    etiquetasColocadas[nombreCalle].push(centro);

                                    ly.setText(nombreCalle, {
                                        repeat: false,
                                        center: true, 
                                        orientation: 'flip',
                                        offset: 0,
                                        attributes: { 
                                            fill: '#FFFF00', 
                                            'font-weight': 'bold', 
                                            'font-size': z >= 18 ? '13' : '10',
                                            'stroke': 'black', 
                                            'stroke-width': '2px', 
                                            'paint-order': 'stroke'
                                        }
                                    });
