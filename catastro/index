<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Visor Urbano Paraná</title>

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <!-- Plugin para nombres de calles en ruta -->
    <script src="https://cdn.jsdelivr.net/npm/leaflet-textpath@1.2.3/leaflet.textpath.min.js"></script>

    <link rel="stylesheet" href="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.css" />
    <script src="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.js"></script>

    <style>
        body { margin:0; padding:0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        #map { height: 100vh; width: 100%; background:#001a33; }

        .panel-superior {
            position:absolute; top:15px; left:60px; z-index:2000;
            background:white; padding:12px; border-radius:8px;
            box-shadow:0 4px 15px rgba(0,0,0,0.3);
            display:flex; gap:10px;
            align-items: center;
        }

        .etiqueta-distrito {
            background:rgba(255,255,255,0.8)!important;
            border:1.5px solid #d35400!important;
            border-radius:4px!important;
            padding:2px 5px!important;
            font-size:11px!important;
            font-weight:bold!important;
            color:#d35400!important;
        }

        .etiqueta-loteo-nro {
            background: rgba(0,0,0,0.75);
            border: 1px solid white;
            color: #00FF00;
            font-weight: bold;
            font-size: 11px;
            padding: 1px 4px;
            border-radius: 3px;
            white-space: nowrap;
            pointer-events: none;
        }

        .btn-streetview {
            display: inline-block;
            margin-top: 8px;
            padding: 5px 10px;
            background-color: #4285F4;
            color: white !important;
            text-decoration: none;
            border-radius: 4px;
            font-size: 11px;
            font-weight: bold;
            text-align: center;
        }

        .layer-legend-icon {
            display: inline-block;
            width: 12px;
            height: 12px;
            margin-right: 8px;
            border: 1px solid #333;
            vertical-align: middle;
        }
        .icon-line { height: 3px; border: none; }

        .popup-loteo, .popup-parcela { font-size: 12px; line-height: 1.4; max-height: 300px; overflow-y: auto; }
        .popup-loteo b, .popup-parcela b { color: #2c3e50; }
        .table-info { width: 100%; border-collapse: collapse; margin-top: 5px; }
        .table-info td { border-bottom: 1px solid #eee; padding: 2px 0; }
    </style>
</head>

<body>

<div class="panel-superior">
    <input type="text" id="input-pm" placeholder="Partida Municipal" style="width:150px; padding:6px;">
    <button onclick="buscarPM()" style="padding:6px 12px; cursor:pointer;">Buscar</button>
    <select id="filtro-distrito" onchange="filtrarDistritos()" style="padding:6px;">
        <option value="todos">-- Todos los Distritos --</option>
    </select>
    <button onclick="abrirStreetViewCentro()" style="padding:6px; background:#fbbc05; border:1px solid #e2a900; border-radius:4px; cursor:pointer;" title="Street View del centro">
        📍 SV
    </button>
</div>

<div id="map"></div>

<script>
// Usamos la URL raw para evitar problemas de indexación de GitHub Pages
const BASE_URL = "https://raw.githubusercontent.com/dcartografiayde/IDE-PARANA/main/";

/* ================= MAPA ================= */
var map = L.map('map',{
    center:[-31.745, -60.51], 
    zoom:13, 
});

var osm = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png');
var sat = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}');
var ref = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Transportation/MapServer/tile/{z}/{y}/{x}');
var hibrido = L.layerGroup([sat,ref]).addTo(map);

/* ================= UTILIDADES ================= */
function getStreetViewLink(lat, lng) {
    return `https://www.google.com/maps/@?api=1&map_action=pano&viewpoint=${lat},${lng}`;
}

function abrirStreetViewCentro() {
    const centro = map.getCenter();
    window.open(getStreetViewLink(centro.lat, centro.lng), '_blank');
}

function getColor(d){
    var colors=['#e6194b','#3cb44b','#ffe119','#4363d8','#f58231','#911eb4','#46f0f0','#f032e6','#fabebe','#008080'];
    var hash=0;
    if(!d) return '#ccc';
    for(var i=0;i<d.length;i++){ hash=d.charCodeAt(i)+((hash<<5)-hash); }
    return colors[Math.abs(hash)%colors.length];
}

function getLineLength(layer) {
    try {
        var latlngs = layer.getLatLngs();
        if (latlngs.length > 0 && Array.isArray(latlngs[0])) { latlngs = latlngs.flat(2); }
        var distance = 0;
        for (var i = 0; i < latlngs.length - 1; i++) {
            if (latlngs[i] && latlngs[i+1]) { distance += latlngs[i].distanceTo(latlngs[i+1]); }
        }
        return distance;
    } catch (e) { return 0; }
}

/* ================= DISTRITOS ================= */
var lyDistritos;
var grupoDistritos=L.layerGroup().addTo(map);

fetch(BASE_URL+"distritos.geojson").then(r=>r.json()).then(data=>{
    lyDistritos=L.geoJSON(data,{
        style:f=>({fillColor:getColor(f.properties.distrito),weight:2.5,color:'white',fillOpacity:0.4}),
        onEachFeature:(f,l)=>{
            if(f.properties.distrito){
                l.bindTooltip(f.properties.distrito,{permanent:true,className:'etiqueta-distrito'});
                var sel=document.getElementById('filtro-distrito');
                if(!Array.from(sel.options).some(o=>o.value===f.properties.distrito)){
                    var opt=document.createElement('option');
                    opt.value=f.properties.distrito;
                    opt.text=f.properties.distrito;
                    sel.add(opt);
                }
            }
        }
    });
    grupoDistritos.addLayer(lyDistritos);
});

/* ================= MANZANAS ================= */
fetch(BASE_URL+"manzana.geojson").then(r=>r.json()).then(data=>{
    L.geoJSON(data,{style:{color:"#555",weight:0.2,fillOpacity:0.01}}).addTo(map);
});

/* ================= CALLES ================= */
var grupoCalles = L.layerGroup().addTo(map);
var capasCalles = [];

fetch(BASE_URL+"calles.geojson").then(r=>r.json()).then(data=>{
    L.geoJSON(data,{
        renderer: L.svg(), 
        style:{ color:"#333", weight:2, opacity:0.02 }, 
        onEachFeature:(f,l)=>{
            if(f.properties.nombre && l instanceof L.Polyline){
                var len = getLineLength(l);
                capasCalles.push({layer: l, nombre: f.properties.nombre, length: len});
                l.on('click', function(e) {
                    var svUrl = getStreetViewLink(e.latlng.lat, e.latlng.lng);
                    l.bindPopup(`<b>Calle:</b> ${f.properties.nombre}<br><a href="${svUrl}" target="_blank" class="btn-streetview">Street View</a>`).openPopup();
                });
            }
        }
    }).addTo(grupoCalles);
    capasCalles.sort((a, b) => b.length - a.length);
    setTimeout(actualizarTextosCalles, 800);
});

function actualizarTextosCalles() {
    var zoomActual = map.getZoom();
    const bounds = map.getBounds();
    const nombresProcesados = new Set();
    const MIN_ZOOM_VIEW = 15; 
    const MAX_ETIQUETAS_PANTALLA = 120; 
    var contador = 0;

    capasCalles.forEach(item => {
        var l = item.layer;
        if (l._text) { try { l.setText(null); } catch(e){} }
        var nombreNorm = item.nombre.trim().toUpperCase();
        var estaEnPantalla = bounds.intersects(l.getBounds());
        var minLengthRequired = zoomActual >= 18 ? 15 : (zoomActual >= 17 ? 40 : 80);
        var cumpleFiltros = zoomActual >= MIN_ZOOM_VIEW && item.length > minLengthRequired && contador < MAX_ETIQUETAS_PANTALLA && !nombresProcesados.has(nombreNorm);

        if (estaEnPantalla && cumpleFiltros) {
            nombresProcesados.add(nombreNorm);
            try {
                l.setText(item.nombre, {
                    repeat: false, center: true, offset: 0, orientation: 'flip', 
                    attributes: { 
                        fill: '#FFFF00', 'font-size': zoomActual >= 18 ? '14' : '11', 
                        'font-weight': 'bold', 'stroke': 'black', 'stroke-width': '2.5px',
                        'paint-order': 'stroke', 'text-transform': 'uppercase'
                    }
                });
                contador++;
            } catch (err) {}
        }
    });
}
map.on('zoomend moveend', actualizarTextosCalles);

/* ================= PARCELAS (CATASTRO) ================= */
var parcelasLayers=[];
var grupoParcelas=L.layerGroup();

// Función para generar contenido del popup de parcelas basado en el estado
function getParcelaPopupContent(f, latlng) {
    const props = f.properties;
    const esPH = props.esPH;
    const svUrl = getStreetViewLink(latlng.lat, latlng.lng);
    
    // Normalizamos el estado para la comparación
    const estado = props.estado_original ? props.estado_original.toString().trim().toUpperCase() : "";

    let html = `<div class="popup-parcela">`;
    
    if (estado === "E" || estado === "B") {
        html += `<center><b>DETALLE COMPLETO</b></center><hr>`;
        html += `<table class="table-info">`;
        // Mostramos todos los campos si es estado E o B
        for (let key in props.full_data) {
            let val = props.full_data[key];
            if (val !== null && val !== undefined && key !== "full_data") {
                html += `<tr><td><b>${key.toUpperCase()}:</b></td><td>${val}</td></tr>`;
            }
        }
        html += `</table>`;
    } else {
        // Otros estados (incluyendo H): Solo info básica
        if (esPH) {
            html += `<b>UNIDAD PH</b><br>Partidas:<br>${props.partidas.join("<br>")}`;
        } else {
            html += `<b>Partida:</b> ${props.partidas[0] || "-"}`;
        }
        html += `<br><b>Ubicación:</b> ${props.ubicacion || "-"}`;
        html += `<br><b>Estado:</b> ${estado || "-"}`;
    }

    html += `<br><a href="${svUrl}" target="_blank" class="btn-streetview">Street View</a>`;
    html += `</div>`;
    return html;
}

// Lista de archivos en la carpeta 'catastro'
["parcela1_4.geojson","parcela5_7.geojson","parcela8_15.geojson"].forEach(nombre=>{
    // Construimos la URL apuntando directamente al archivo en RAW
    const fileUrl = BASE_URL + "catastro/" + nombre;
    
    fetch(fileUrl).then(r => {
        if (!r.ok) throw new Error(`HTTP error! status: ${r.status}`);
        return r.json();
    }).then(data=>{
        var grupos = {};
        data.features.forEach(f=>{
            var key = JSON.stringify(f.geometry.coordinates);
            if(!grupos[key]) grupos[key]=[];
            grupos[key].push(f);
        });

        var featuresAgrupadas = Object.values(grupos).map(grupo=>{
            var base = grupo[0];
            return {
                type:"Feature", 
                geometry: base.geometry,
                properties:{ 
                    esPH: grupo.length > 1, 
                    partidas: grupo.map(g=>g.properties.nropasd), 
                    ubicacion: base.properties.ubipar1,
                    estado_original: base.properties.estado || "",
                    full_data: base.properties 
                }
            };
        });

        var layer=L.geoJSON(featuresAgrupadas,{
            style:f=>({ 
                color: f.properties.esPH ? "#8e44ad" : "#2980b9", 
                weight: f.properties.esPH ? 1.5 : 0.6, 
                fillOpacity: f.properties.esPH ? 0.2 : 0.1 
            }),
            onEachFeature:(f,l)=>{
                l.on('click', function(e) {
                    l.bindPopup(getParcelaPopupContent(f, e.latlng)).openPopup();
                });
            }
        });
        layer.eachLayer(l => l.bringToBack());
        parcelasLayers.push(layer);
        grupoParcelas.addLayer(layer);
    }).catch(err => console.error("Error cargando:", fileUrl, err));
});

/* ================= LOTEOS ================= */
var grupoLoteosPrivadosHabilitados = L.layerGroup();
var grupoLoteosPrivadosAprobados = L.layerGroup();
var grupoLoteosSinOrdenanza = L.layerGroup();
var grupoLoteosPrivadosInfoAdicional = L.layerGroup();
var grupoIAPV = L.layerGroup();

var loteoTooltips = [];

function popupLoteos(f, titulo, latlng) {
    let p = f.properties;
    let svUrl = latlng ? getStreetViewLink(latlng.lat, latlng.lng) : null;
    return `<div class="popup-loteo">
        <center><b>LOTEO ${titulo.toUpperCase()}</b></center><hr>
        <b>Nro:</b> ${p.nro || p.nro_ref || "-"}<br>
        <b>Propietario:</b> ${p.propietario || "-"}<br>
        <b>Ordenanza:</b> ${p.ordenanza || p["ord.año"] || "-"}<br>
        <b>Expediente:</b> ${p.expte || p.exp_s_cat || "-"} / ${p.anio || "-"}<br>
        <b>Trámite:</b> ${p.tramite || "-"}<br>
        <b>Cant. Lotes:</b> ${p.cant_lotes || "-"}<br>
        <b>Sup. (Ha):</b> ${p.sup_en_has || "-"}<br>
        <b>Estado:</b> ${p.etiqueta || "-"}<br>
        ${svUrl ? `<a href="${svUrl}" target="_blank" class="btn-streetview">Street View</a>` : ''}
    </div>`;
}

const configLoteos = [
    { file: "backdoor/loteos_privados_habilitados.geojson", grupo: grupoLoteosPrivadosHabilitados, color: "#39FF14", titulo: "Habilitado", label: true },
    { file: "backdoor/loteos_privados_aprobados.geojson", grupo: grupoLoteosPrivadosAprobados, color: "#FFFF33", titulo: "Aprobado", label: true },
    { file: "backdoor/loteos_sin_ordenanza.geojson", grupo: grupoLoteosSinOrdenanza, color: "#FF00FF", titulo: "Sin Ordenanza", label: true },
    { file: "backdoor/loteos_privados.geojson", grupo: grupoLoteosPrivadosInfoAdicional, color: "#00FFFF", titulo: "Info Adicional", label: false }
];

configLoteos.forEach(item => {
    fetch(BASE_URL + item.file).then(r=>r.json()).then(data => {
        L.geoJSON(data, {
            style: { 
                color: item.color, weight: 2.5, fillColor: item.color, fillOpacity: 0.25, 
                dashArray: item.label ? '' : '4,4' 
            },
            onEachFeature: (f,l) => {
                if (item.label) {
                    var nroVal = f.properties.nro || f.properties.nro_ref || "";
                    if (nroVal) {
                        l.bindTooltip(String(nroVal), {
                            permanent: true, direction: 'center', className: 'etiqueta-loteo-nro', opacity: 0.9
                        });
                        loteoTooltips.push(l);
                    }
                }
                l.on('click', function(e) { l.bindPopup(popupLoteos(f, item.titulo, e.latlng)).openPopup(); });
            }
        }).addTo(item.grupo);
    });
});

map.on('zoomend', function() {
    var zoom = map.getZoom();
    loteoTooltips.forEach(layer => {
        if (zoom < 15) { if (layer.getTooltip()) layer.closeTooltip(); }
        else { if (layer.getTooltip()) layer.openTooltip(); }
    });
});

fetch(BASE_URL+"iapv.geojson").then(r=>r.json()).then(data=>{
    L.geoJSON(data,{
        style:{color:"#FF4500",weight:2,fillColor:"#FF4500",fillOpacity:0.3},
        onEachFeature:(f,l)=>l.bindPopup("<b>IAPV</b><br>"+(f.properties.barrio || "-"))
    }).addTo(grupoIAPV);
});

var grupoCocherasZonificacion = L.layerGroup();
fetch(BASE_URL+"cocheras_porcentaje_zona.geojson").then(r=>r.json()).then(data=>{
    function getZC(p){ return p >= 20 ? "#4a148c" : p >= 15 ? "#7b1fa2" : "#ce93d8"; }
    L.geoJSON(data,{
        style: f => ({ color: "#000", weight: 2, fillColor: getZC(parseFloat(f.properties.porcentaje)||0), fillOpacity: 0.5 }),
        onEachFeature: (f,l) => { l.bindPopup("<b>Zonificación Cocheras</b><br>" + f.properties.porcentaje + "%"); }
    }).addTo(grupoCocherasZonificacion);
});

/* ================= CONTROL DE CAPAS ================= */
function createLayerLabel(color, name, isLine = false) {
    const typeClass = isLine ? 'layer-legend-icon icon-line' : 'layer-legend-icon';
    return `<span class="${typeClass}" style="background-color: ${color}; border: 1px solid #fff;"></span>${name}`;
}

const baseLayers = { "Híbrido": hibrido, "OSM": osm };
const overlays = {
    [createLayerLabel('#d35400', 'Distritos')]: grupoDistritos,
    [createLayerLabel('#FFFF00', 'Calles', true)]: grupoCalles,
    [createLayerLabel('#2980b9', 'Parcelas')]: grupoParcelas,
    [createLayerLabel('#7b1fa2', 'Cocheras')]: grupoCocherasZonificacion,
    [createLayerLabel('#39FF14', 'Loteos Habilitados')]: grupoLoteosPrivadosHabilitados,
    [createLayerLabel('#FFFF33', 'Loteos Aprobados')]: grupoLoteosPrivadosAprobados,
    [createLayerLabel('#FF00FF', 'Loteos Sin Ord.')]: grupoLoteosSinOrdenanza,
    [createLayerLabel('#00FFFF', 'Otros Loteos - Info Adicional')]: grupoLoteosPrivadosInfoAdicional,
    [createLayerLabel('#FF4500', 'IAPV')]: grupoIAPV
};

L.control.layers(baseLayers, overlays).addTo(map);
L.Control.geocoder({position:'topright'}).addTo(map);

/* ================= BUSQUEDA ================= */
function buscarPM(){
    var val = document.getElementById('input-pm').value.trim();
    if(!val) return;
    grupoParcelas.addTo(map);
    parcelasLayers.forEach(layer=>{
        layer.eachLayer(l=>{
            var partidas = (l.feature.properties.partidas || []).map(String);
            if(partidas.includes(val)){
                map.fitBounds(l.getBounds());
                l.openPopup();
            }
        });
    });
}

function filtrarDistritos(){
    var val=document.getElementById('filtro-distrito').value;
    if(!lyDistritos) return;
    lyDistritos.eachLayer(l=>{
        var visible=(val==="todos"||l.feature.properties.distrito===val);
        l.setStyle({opacity:visible?1:0,fillOpacity:visible?0.4:0});
        if(l.getTooltip()) l.getTooltip().setOpacity(visible?0.9:0);
    });
}
</script>
</body>
</html>
